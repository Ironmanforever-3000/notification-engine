{
  "name": "notification-engine",
  "version": "1.0.0",
  "description": "Event-driven notification engine for financial applications",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "postinstall": "prisma skills sync || exit 0"
  },
  "keywords": [
    "notification",
    "event-driven",
    "financial",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "~5.7.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^18.0.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  }
}
